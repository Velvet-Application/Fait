# Google Cloud OAuth 2.0 — application Web
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facultatif en local. En production, définir l’URI exacte déclarée dans Google Cloud.
# Exemple : https://votre-preview.vercel.app/api/google/oauth/callback
GOOGLE_OAUTH_REDIRECT_URI=

# Au moins 32 caractères aléatoires. Utilisé pour chiffrer la session OAuth HttpOnly.
FAIT_SESSION_SECRET=
